<Window x:Class="OhMySkill.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oh My Skill" Height="760" Width="1180" MinHeight="620" MinWidth="900"
        Icon="/OhMySkill;component/Assets/Branding/OhMySkill.ico"
        Background="#0A101C" Foreground="#EAF1FF" WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,24">
      <Image Source="/OhMySkill;component/Assets/Branding/p3.png" Width="34" Height="34" Stretch="Uniform" Margin="0,0,12,0" AutomationProperties.Name="Oh My Skill logo" />
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Oh My Skill" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="Teach a computer workflow once. Save a portable SKILL.md." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
      </StackPanel>
      <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="Local-first" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,26,0">
        <Button Content="Build a Skill" Click="BuildSkill_Click" />
        <Button Content="Saved Skills" Click="SavedSkills_Click" />
        <Button Content="AI Settings" Click="Settings_Click" />
        <Border Background="#111C2D" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,22,0,0">
          <StackPanel>
            <TextBlock Text="What is saved?" FontWeight="SemiBold" />
            <TextBlock Text="Only the final SKILL.md is kept by default. Audio, frames, and event traces are encrypted temporarily and deleted after saving." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <Grid>
          <StackPanel x:Name="HomePanel">
            <Image Source="/OhMySkill;component/Assets/Branding/p3.png" Width="112" Height="112" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="Oh My Skill logo" Margin="0,0,0,18" />
            <TextBlock Text="Build a reusable computer skill" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Record a task in any Windows application while you explain what matters. Oh My Skill turns the evidence into concise instructions for the agent you already use." Foreground="{StaticResource MutedBrush}" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,22" />
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
              <StackPanel>
                <TextBlock Text="Start with a visible, repeatable task" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="Examples: rename and organize files, complete a form, prepare a report, or move information between applications." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                <Button Content="Record New Skill" Width="170" HorizontalAlignment="Left" Click="BuildSkill_Click" Background="{StaticResource AccentDarkBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
            <TextBlock Text="New recording" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Keep the recording visible. Explain changing values, optional steps, secrets, conditions, and what success looks like." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,16" />
            <Label Content="Skill title" />
            <TextBox x:Name="TitleBox" Text="Computer workflow" />
            <Label Content="Capture source" />
            <ComboBox x:Name="CaptureModeBox" SelectionChanged="CaptureMode_Changed">
              <ComboBoxItem Content="Entire display" Tag="Display" />
              <ComboBoxItem Content="Selected window" Tag="Window" />
            </ComboBox>
            <Label Content="Window (used for selected-window capture)" />
            <ComboBox x:Name="WindowBox" DisplayMemberPath="Title" />
            <TextBlock Text="Microphone narration is captured only while recording. Audio is timestamped, transcribed, attached to nearby actions, and used to infer intent. Typed characters and clipboard contents are not persisted." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,20" />
            <StackPanel Orientation="Horizontal">
              <Button Content="Start Recording" Click="StartRecording_Click" Background="{StaticResource AccentDarkBrush}" />
              <Button Content="Cancel" Click="Home_Click" />
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="RecordingPanel" Visibility="Collapsed">
            <Image Source="/OhMySkill;component/Assets/Branding/p3.png" Width="56" Height="56" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="Oh My Skill logo" />
            <TextBlock Text="Recording" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="RecordingTimer" Text="00:00" FontSize="44" FontWeight="SemiBold" Margin="0,14,0,8" />
            <TextBlock x:Name="AudioStatus" Text="Microphone: checking" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
            <TextBlock x:Name="RecordingStatus" Text="Recording screen and interaction context…" Foreground="{StaticResource MutedBrush}" />
            <Border Background="#4B1F2B" BorderBrush="#9C4B5D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,22,0,22">
              <TextBlock Text="Recording is active. Do not enter passwords or private information unless you mark it private immediately." TextWrapping="Wrap" Foreground="#FFD8E0" />
            </Border>
            <StackPanel Orientation="Horizontal">
              <Button Content="Mark Step" Click="MarkStep_Click" />
              <Button Content="Redact Last 15 Seconds" ToolTip="Removes recent frames and events; the complete microphone recording is discarded for safety." Click="Redact_Click" />
              <Button Content="Finish &amp; Build Draft" Click="FinishRecording_Click" Background="{StaticResource AccentDarkBrush}" />
            </StackPanel>
            <TextBlock x:Name="EventPreview" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,22,0,0" />
          </StackPanel>

          <StackPanel x:Name="ReviewPanel" Visibility="Collapsed">
            <Image Source="/OhMySkill;component/Assets/Branding/p3.png" Width="56" Height="56" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="Oh My Skill logo" />
            <TextBlock Text="Review the generated skill" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="ReviewStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14" />
            <Border Background="#111C2D" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
              <TextBlock x:Name="EvidenceSummary" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}" />
            </Border>
            <Label Content="Action evidence (before / after)" />
            <ListBox x:Name="EvidenceList" MaxHeight="300" Background="#0B1220" BorderBrush="{StaticResource PanelBorderBrush}" Foreground="{StaticResource InkBrush}" Margin="0,0,0,14">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="8">
                    <StackPanel>
                      <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Image Source="{Binding BeforeImage}" Width="180" Height="100" Stretch="Uniform" Margin="0,0,8,0" AutomationProperties.Name="Before action frame" />
                        <Image Source="{Binding AfterImage}" Width="180" Height="100" Stretch="Uniform" AutomationProperties.Name="After action frame" />
                      </StackPanel>
                      <TextBlock Text="{Binding Narration}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                      <TextBlock Text="{Binding Interpretation}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Label Content="Skill name" />
            <TextBox x:Name="ReviewNameBox" />
            <Label Content="Description" />
            <TextBox x:Name="ReviewDescriptionBox" />
            <Label Content="Inferred user intent" />
            <TextBox x:Name="ReviewIntentBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55" />
            <Label Content="Goal" />
            <TextBox x:Name="ReviewGoalBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55" />
            <Label Content="Required inputs (one per line: name | description | secret=true/false)" />
            <TextBox x:Name="ReviewInputsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
            <Label Content="Procedure (one step per line)" />
            <TextBox x:Name="ReviewProcedureBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" />
            <Label Content="Safety" />
            <TextBox x:Name="ReviewSafetyBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
            <Label Content="Verification" />
            <TextBox x:Name="ReviewVerificationBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
            <Label Content="Recovery" />
            <TextBox x:Name="ReviewRecoveryBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
            <TextBlock Text="Preview" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,6" />
            <TextBox x:Name="MarkdownPreviewBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="300" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="Save SKILL.md" Click="SaveSkill_Click" Background="{StaticResource AccentDarkBrush}" />
              <Button Content="Back to Home" Click="Home_Click" />
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
            <TextBlock Text="AI settings" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="BYOK keys are encrypted with Windows DPAPI for this user. Leave AI disabled to generate a deterministic local draft from captured events." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,16" />
            <Label Content="Provider" />
            <ComboBox x:Name="ProviderBox" SelectionChanged="Provider_Changed" />
            <Label Content="Endpoint" />
            <TextBox x:Name="EndpointBox" />
            <Label Content="Model" />
            <TextBox x:Name="ModelBox" />
            <Label Content="API key (leave blank to keep the saved key)" />
            <PasswordBox x:Name="ApiKeyBox" Background="#0B1220" Foreground="{StaticResource InkBrush}" BorderBrush="#334765" Padding="8" />
            <CheckBox x:Name="UseAiBox" Content="Use this provider to create the draft" Foreground="{StaticResource InkBrush}" Margin="0,14,0,18" />
            <StackPanel Orientation="Horizontal">
              <Button Content="Save Settings" Click="SaveSettings_Click" Background="{StaticResource AccentDarkBrush}" />
              <Button Content="Test Connection" Click="TestConnection_Click" />
            </StackPanel>
            <TextBlock x:Name="SettingsStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,18,0,0" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
