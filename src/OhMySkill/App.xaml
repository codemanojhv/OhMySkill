<Application x:Class="OhMySkill.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="InkBrush" Color="#EAF1FF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9EACC7" />
    <SolidColorBrush x:Key="PanelBrush" Color="#101827" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#24324A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#79A8FF" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#1A4F9C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF8D8D" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="Background" Value="#1B2A43" />
      <Setter Property="BorderBrush" Value="#35527B" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="Background" Value="#0B1220" />
      <Setter Property="BorderBrush" Value="#334765" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#142033" />
      <Setter Property="Background" Value="#EAF1FF" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
  </Application.Resources>
</Application>
